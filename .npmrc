auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
link-workspace-packages=true
prefer-workspace-packages=true

# NOTE: pnpm 11 reads dangerouslyAllowAllBuilds / minimumReleaseAge only from
# pnpm-workspace.yaml — putting them here (or in package.json's "pnpm" field)
# has no effect. They live in pnpm-workspace.yaml.
