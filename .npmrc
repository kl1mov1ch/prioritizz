auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
link-workspace-packages=true
prefer-workspace-packages=true

# Dependency build scripts: pnpm 10+ gates them and, with no TTY to run
# `pnpm approve-builds`, exits 1 (ERR_PNPM_IGNORED_BUILDS) on anything it has
# not been told about. The allow/ignore lists live in package.json under "pnpm";
# this is the fallback for Docker/CI where that gate must never fail the build.
# Everything installed here comes from a committed lockfile.
dangerously-allow-all-builds=true

# Skip the 895-entry "Verifying lockfile against supply-chain policies" pass:
# one registry request per locked package, which on this VPS's throttled route
# to registry.npmjs.org costs 3-5 min and times out at random.
minimum-release-age=0
