# ─────────────────────────────────────────────────────────────
# Prioritizz — environment template. Copy to .env for local dev.
# All values validated at boot by @prioritizz/config env schema.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
APP_MODE=http                       # http | worker  (api process role)

# ---- API ----
API_PORT=3000
API_BASE_URL=http://localhost:3000
API_GLOBAL_PREFIX=api
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://t.me

# ---- Database ----
DATABASE_URL=postgresql://prioritizz:prioritizz@localhost:5432/prioritizz?schema=public

# ---- Redis / BullMQ ----
REDIS_URL=redis://localhost:6379
BULLMQ_PREFIX=prioritizz

# ---- Auth / JWT ----
JWT_ACCESS_SECRET=dev_access_secret_change_me_32chars_min
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_32chars_min
JWT_ACCESS_TTL=900                  # seconds (15m)
JWT_REFRESH_TTL=2592000             # seconds (30d)
INITDATA_MAX_AGE_SEC=86400          # reject Telegram initData older than this

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=123456:CHANGE_ME
TELEGRAM_BOT_USERNAME=PrioritizzBot
TELEGRAM_WEBHOOK_SECRET=dev_webhook_secret_change_me
MINI_APP_URL=http://localhost:5173
ADMIN_TELEGRAM_ALLOWLIST=            # comma-separated telegram ids granted admin

# ---- Money ----
PLATFORM_CURRENCY=XTR               # XTR (Telegram Stars) | USD | EUR
DEFAULT_COMMISSION_BPS=1000         # 10.00%
DEFAULT_MIN_FEE=1
ESCROW_AUTO_RELEASE_HOURS=72
DISPUTE_SLA_HOURS=48

# ---- Payment providers ----
PAYMENT_PROVIDERS=telegram_stars    # comma-separated enabled adapters
CRYPTOPAY_API_TOKEN=
CRYPTOPAY_WEBHOOK_SECRET=

# ---- Storage (S3 / MinIO) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=prioritizz-media
S3_ACCESS_KEY_ID=prioritizz
S3_SECRET_ACCESS_KEY=prioritizz
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/prioritizz-media

# ---- Mail ----
SMTP_URL=smtp://localhost:1025
MAIL_FROM=no-reply@prioritizz.local

# ---- Observability ----
LOG_LEVEL=debug                     # trace|debug|info|warn|error
LOG_PRETTY=true

# ---- Frontends (Vite, prefix VITE_) ----
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_TELEGRAM_BOT_USERNAME=PrioritizzBot
VITE_SENTRY_DSN=
